---
import type { OfferSection, Product } from '../lib/sanity';

interface Props {
  offerSection?: OfferSection | null;
  products?: Product[];
}

const { offerSection, products = [] } = Astro.props;

const sectionTitle = offerSection?.sectionTitle || "Nasza oferta";
const introText = offerSection?.introText || "Oferujemy świeże warzywa w konkurencyjnych cenach. Przy większych zamówieniach możliwość negocjacji ceny.";

const displayProducts = products.length > 0 ? products : [
  { _id: '1', name: "Ziemniaki", description: "Świeże ziemniaki jadalne różnych odmian. Idealne do gotowania, pieczenia, smażenia i purée.", isAvailable: true, order: 0 },
  { _id: '2', name: "Marchew", description: "Słodka i soczysta marchew. Doskonała do surówek, zup, dań obiadowych oraz świeżych soków.", isAvailable: true, order: 1 },
  { _id: '3', name: "Buraki", description: "Świeże buraki ćwikłowe, bogate w witaminy i minerały. Idealne na barszcz i surówki.", isAvailable: true, order: 2 },
  { _id: '4', name: "Cebula", description: "Aromatyczna cebula - podstawa każdej kuchni. Doskonała do duszenia, smażenia i na surowo.", isAvailable: true, order: 3 },
  { _id: '5', name: "Kapusta biała", description: "Klasyczna kapusta biała, idealna do surówek, bigosu, gołąbków i kiszenia.", isAvailable: true, order: 4 },
  { _id: '6', name: "Pietruszka", description: "Świeża pietruszka korzeniowa. Niezbędny składnik rosołu i wielu innych potraw.", isAvailable: true, order: 5 },
];
---

<section id="oferta" class="section section--green offer">
  <div class="container">
    <h2 class="section__title">{sectionTitle}</h2>

    <p class="offer__intro">
      {introText}
    </p>

    <div class="offer__grid">
      {
        displayProducts.map((product) => (
          <article class="offer__card">
            <h3 class="offer__card-title">{product.name}</h3>
            <p class="offer__card-description">{product.description}</p>
            <span class={`offer__card-status ${product.isAvailable ? '' : 'offer__card-status--unavailable'}`}>
              {product.isAvailable ? 'Dostępne' : 'Niedostępne'}
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .offer__intro {
    text-align: center;
    font-size: var(--font-size-large);
    color: var(--color-gray);
    max-width: 600px;
    margin: 0 auto var(--spacing-xl);
  }

  .offer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .offer__card {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-sm);
    text-align: center;
    border: 2px solid transparent;
  }

  .offer__card:hover {
    border-color: var(--color-primary-light);
  }

  .offer__card-title {
    font-size: var(--font-size-h3);
    color: var(--color-primary-dark);
    margin-bottom: var(--spacing-xs);
  }

  .offer__card-description {
    color: var(--color-gray);
    margin-bottom: var(--spacing-md);
  }

  .offer__card-status {
    font-size: var(--font-size-small);
    color: var(--color-primary);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .offer__card-status::before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 10px;
    background-color: var(--color-primary);
    border-radius: 50%;
  }

  .offer__card-status--unavailable {
    color: var(--color-gray);
  }

  .offer__card-status--unavailable::before {
    background-color: var(--color-gray);
  }

  .offer__note {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    text-align: center;
    border-left: 4px solid var(--color-primary);
  }

  .offer__note p {
    margin-bottom: var(--spacing-md);
    color: var(--color-dark);
  }

  .offer__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  /* Tablet */
  @media (min-width: 600px) {
    .offer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .offer__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-xl);
    }

    .offer__card {
      padding: var(--spacing-xl);
    }
  }
</style>
