---
import type { About } from '../lib/sanity';

interface Props {
  about?: About | null;
}

const { about } = Astro.props;

const sectionTitle = about?.sectionTitle || "O nas";
const description = about?.description || "Jesteśmy rodzinnym gospodarstwem rolnym specjalizującym się w uprawie warzyw. Od wielu lat dostarczamy świeże produkty dla klientów indywidualnych oraz hurtowych. Nasze gospodarstwo znajduje się na żyznych glebach, co gwarantuje najwyższą jakość uprawianych warzyw.";

const features = about?.features || [
  {
    _key: '1',
    icon: "🌱",
    title: "Naturalna uprawa",
    description: "Warzywa uprawiane bez sztucznych nawozów i środków chemicznych"
  },
  {
    _key: '2',
    icon: "🚜",
    title: "Prosto z pola",
    description: "Warzywa trafiają do klienta świeżo zebrane, bez długiego przechowywania"
  },
  {
    _key: '3',
    icon: "💰",
    title: "Uczciwe ceny",
    description: "Konkurencyjne ceny bez pośredników - kupujesz bezpośrednio od producenta"
  },
  {
    _key: '4',
    icon: "🤝",
    title: "Wieloletnie doświadczenie",
    description: "Rodzinne gospodarstwo z tradycją przekazywaną od pokoleń"
  }
];
---

<section id="o-nas" class="section section--light about">
  <div class="container">
    <h2 class="section__title">{sectionTitle}</h2>

    <div class="about__content">
      <p class="about__description">
        {description}
      </p>
    </div>

    <div class="about__features">
      {features.map((feature) => (
        <div class="about__feature">
          <span class="about__feature-icon" aria-hidden="true">{feature.icon}</span>
          <h3 class="about__feature-title">{feature.title}</h3>
          {feature.description && (
            <p class="about__feature-description">{feature.description}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about__content {
    max-width: 800px;
    margin: 0 auto var(--spacing-xl);
    text-align: center;
  }

  .about__description {
    font-size: var(--font-size-large);
    color: var(--color-gray);
    line-height: 1.8;
  }

  .about__features {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }

  .about__feature {
    background-color: var(--color-white);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .about__feature-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--spacing-sm);
  }

  .about__feature-title {
    font-size: var(--font-size-h3);
    color: var(--color-primary-dark);
    margin-bottom: var(--spacing-xs);
  }

  .about__feature-description {
    color: var(--color-gray);
    margin-bottom: 0;
  }

  /* Tablet */
  @media (min-width: 600px) {
    .about__features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .about__features {
      grid-template-columns: repeat(4, 1fr);
    }

    .about__feature {
      padding: var(--spacing-xl) var(--spacing-lg);
    }
  }
</style>
