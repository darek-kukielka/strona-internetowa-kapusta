<section class="hero">
  <div class="container hero__container">
    <div class="hero__content">
      <h1 class="hero__title">
        Świeża kapusta <span class="hero__title-highlight">prosto od rolnika</span>
      </h1>
      <p class="hero__description">
        Oferujemy najwyższej jakości kapustę białą, czerwoną, kiszoną i pekińską.
        Warzywa uprawiane tradycyjnymi metodami, bez chemii.
        Sprzedaż detaliczna i hurtowa.
      </p>
      <div class="hero__actions">
        <a href="#oferta" class="btn btn--primary hero__btn">
          Zobacz ofertę
        </a>
        <a href="tel:+48123456789" class="btn btn--outline hero__btn">
          📞 Zadzwoń teraz
        </a>
      </div>
    </div>
    <div class="hero__image" aria-hidden="true">
      <div class="hero__image-placeholder">
        🥬
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-light-green) 0%, var(--color-white) 100%);
    padding: var(--spacing-xxl) 0;
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .hero__content {
    text-align: center;
  }

  .hero__title {
    font-size: var(--font-size-h1);
    color: var(--color-dark);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__title-highlight {
    color: var(--color-primary);
    display: block;
  }

  .hero__description {
    font-size: var(--font-size-large);
    color: var(--color-gray);
    margin-bottom: var(--spacing-lg);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    align-items: center;
  }

  .hero__btn {
    width: 100%;
    max-width: 280px;
    text-align: center;
  }

  .hero__image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__image-placeholder {
    width: 200px;
    height: 200px;
    background-color: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8rem;
    box-shadow: var(--shadow-md);
    border: 4px solid var(--color-primary-light);
  }

  /* Desktop */
  @media (min-width: 769px) {
    .hero {
      padding: var(--spacing-xxl) 0;
      min-height: 500px;
      display: flex;
      align-items: center;
    }

    .hero__container {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-xxl);
    }

    .hero__content {
      text-align: left;
    }

    .hero__title {
      font-size: 3rem;
    }

    .hero__title-highlight {
      display: inline;
    }

    .hero__description {
      margin-left: 0;
      margin-right: 0;
    }

    .hero__actions {
      flex-direction: row;
      justify-content: flex-start;
    }

    .hero__btn {
      width: auto;
    }

    .hero__image-placeholder {
      width: 300px;
      height: 300px;
      font-size: 12rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__title {
      font-size: 3.5rem;
    }

    .hero__image-placeholder {
      width: 350px;
      height: 350px;
    }
  }
</style>
