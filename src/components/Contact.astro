---
import type { ContactSection, SiteSettings } from '../lib/sanity';

interface Props {
  contactSection?: ContactSection | null;
  siteSettings?: SiteSettings | null;
}

const { contactSection, siteSettings } = Astro.props;

const sectionTitle = contactSection?.sectionTitle || "Kontakt";
const showMap = contactSection?.showMap !== false;

const phone = siteSettings?.contact?.phone || "+48 123 456 789";
const phoneLink = phone.replace(/\s/g, '');
const email = siteSettings?.contact?.email || "kontakt@example.com";
const address = siteSettings?.contact?.address || "ul. Przykładowa 1, 00-000 Miasto";
const mapLat = siteSettings?.contact?.mapCoordinates?.lat || "52.2297";
const mapLng = siteSettings?.contact?.mapCoordinates?.lng || "21.0122";

const openingHours = siteSettings?.openingHours || [
  { _key: '1', days: "Poniedziałek - Piątek", hours: "8:00 - 18:00" },
  { _key: '2', days: "Sobota", hours: "8:00 - 14:00" },
  { _key: '3', days: "Niedziela", hours: "Zamknięte" }
];

// URL do Google Maps embed
const mapUrl = `https://maps.google.com/maps?q=${mapLat},${mapLng}&z=15&output=embed`;
---

<section id="kontakt" class="section contact">
  <div class="container">
    <h2 class="section__title">{sectionTitle}</h2>

    <div class="contact__grid">
      <div class="contact__info">
        <div class="contact__card">
          <h3 class="contact__card-title">
            <span class="contact__icon" aria-hidden="true">📞</span>
            Telefon
          </h3>
          <a href={`tel:${phoneLink}`} class="contact__link contact__link--phone">
            {phone}
          </a>
          <p class="contact__note">Zadzwoń, aby złożyć zamówienie lub zapytać o dostępność</p>
        </div>

        <div class="contact__card">
          <h3 class="contact__card-title">
            <span class="contact__icon" aria-hidden="true">📧</span>
            Email
          </h3>
          <a href={`mailto:${email}`} class="contact__link">
            {email}
          </a>
          <p class="contact__note">Odpowiadamy w ciągu 24 godzin</p>
        </div>

        <div class="contact__card">
          <h3 class="contact__card-title">
            <span class="contact__icon" aria-hidden="true">📍</span>
            Adres
          </h3>
          <address class="contact__address">
            {address}
          </address>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${mapLat},${mapLng}`}
            target="_blank"
            rel="noopener noreferrer"
            class="contact__link"
          >
            Pokaż trasę w Google Maps →
          </a>
        </div>

        <div class="contact__card">
          <h3 class="contact__card-title">
            <span class="contact__icon" aria-hidden="true">🕐</span>
            Godziny otwarcia
          </h3>
          <ul class="contact__hours">
            {openingHours.map((item) => (
              <li class="contact__hours-item">
                <span class="contact__hours-days">{item.days}</span>
                <span class="contact__hours-time">{item.hours}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {showMap && (
        <div class="contact__map">
          <h3 class="sr-only">Mapa lokalizacji</h3>
          <div class="contact__map-container">
            <iframe
              src={mapUrl}
              width="100%"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa lokalizacji gospodarstwa"
            ></iframe>
          </div>
          <p class="contact__map-note">
            Kliknij mapę, aby otworzyć w Google Maps
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  .contact__info {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  .contact__card {
    background-color: var(--color-light);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
  }

  .contact__card-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-h3);
    color: var(--color-primary-dark);
    margin-bottom: var(--spacing-sm);
  }

  .contact__icon {
    font-size: 1.5rem;
  }

  .contact__link {
    display: block;
    font-size: var(--font-size-large);
    color: var(--color-primary);
    margin-bottom: var(--spacing-xs);
  }

  .contact__link--phone {
    font-size: 1.5rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .contact__note {
    font-size: var(--font-size-small);
    color: var(--color-gray);
    margin-bottom: 0;
  }

  .contact__address {
    font-style: normal;
    font-size: var(--font-size-large);
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    color: var(--color-dark);
  }

  .contact__hours {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact__hours-item {
    display: flex;
    justify-content: space-between;
    padding: var(--spacing-xs) 0;
    border-bottom: 1px solid var(--color-gray-light);
    font-size: var(--font-size-base);
  }

  .contact__hours-item:last-child {
    border-bottom: none;
  }

  .contact__hours-days {
    color: var(--color-dark);
  }

  .contact__hours-time {
    font-weight: 600;
    color: var(--color-primary);
  }

  .contact__map-container {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background-color: var(--color-light);
  }

  .contact__map-container iframe {
    display: block;
    width: 100%;
    min-height: 300px;
  }

  .contact__map-note {
    text-align: center;
    font-size: var(--font-size-small);
    color: var(--color-gray);
    margin-top: var(--spacing-sm);
    margin-bottom: 0;
  }

  /* Tablet */
  @media (min-width: 600px) {
    .contact__info {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-xxl);
    }

    .contact__info {
      grid-template-columns: 1fr;
    }

    .contact__map-container iframe {
      min-height: 100%;
      height: 100%;
    }

    .contact__map-container {
      height: 100%;
      min-height: 400px;
    }
  }
</style>
